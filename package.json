{
  "name": "@loud/monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @loud/web build && pnpm --filter @loud/desktop dev",
    "start": "pnpm build && pnpm --filter @loud/desktop start",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "check:repo": "node scripts/check-repo.mjs"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@12.14.0"
}
