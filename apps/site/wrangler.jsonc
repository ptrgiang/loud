// loud.trysometh.ing: static pages, plus /api/usage and /api/stats from src/worker.ts. The custom domain makes Cloudflare
// create the DNS record and certificate on deploy (the trysometh.ing zone is in the same account).
{
  "name": "loud-site",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Without this a missing /api path would get the 404 page before the Worker sees it.
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "loud-usage",
      "database_id": "9990d865-2f3c-4790-a7f4-d0234c6da410",
      "migrations_dir": "migrations",
    },
  ],
  // Deletes reports older than 400 days.
  "triggers": { "crons": ["17 3 * * *"] },
  "routes": [{ "pattern": "loud.trysometh.ing", "custom_domain": true }],
  // Request logs would hold IP addresses; privacy.html says they are off.
  "observability": { "enabled": false },
  "workers_dev": false,
  "preview_urls": false,
}
