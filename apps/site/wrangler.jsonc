// loud.trysometh.ing: a Worker with only static assets. The custom domain makes Cloudflare create the DNS record and
// certificate on deploy (the trysometh.ing zone is in the same account).
{
  "name": "loud-site",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
  "routes": [{ "pattern": "loud.trysometh.ing", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
}
