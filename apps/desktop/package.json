{
  "name": "@loud/desktop",
  "version": "0.1.11-beta.9",
  "private": true,
  "description": "A desktop app for people who build things and forget to tell anyone.",
  "homepage": "https://loud.trysometh.ing",
  "author": "Try Something",
  "repository": "github:ptrgiang/loud",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "demo": "node scripts/build.mjs && node dist-electron/demo.cjs",
    "dev": "node scripts/build.mjs && electron .",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p .",
    "test": "vp test run --passWithNoTests",
    "dist": "electron-builder --publish never",
    "release": "electron-builder --publish always"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "catalog:",
    "@loud/contracts": "workspace:*",
    "@loud/shared": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "electron": "catalog:",
    "electron-builder": "catalog:",
    "electron-updater": "catalog:",
    "esbuild": "catalog:",
    "vite-plus": "catalog:"
  },
  "productName": "Loud"
}
